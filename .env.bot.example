# See wiki/dotenv-bot-secret.md

# Telegram bot token
# Get from @BotFather on Telegram
BOT_TOKEN=<bot-token>

# LMS API
# Base URL of the LMS backend service
LMS_API_BASE_URL=http://localhost:42002
# API key for authenticating with the LMS backend
LMS_API_KEY=<lms-api-key>

# LLM API
# Model name for the LLM (e.g., coder-model for Qwen Code API)
LLM_API_MODEL=coder-model
# API key for the LLM service
LLM_API_KEY=<llm-api-key>
# Base URL for the LLM API (e.g., http://localhost:42005/v1 for Qwen Code API)
LLM_API_BASE_URL=<llm-api-base-url>
